---
import Header from '../components/Header.astro';
import { siteTitle, siteDescription } from '../lib/posts';
import '../styles/reader.css';
interface Props { title?: string; description?: string; section?: string; math?: boolean; noindex?: boolean }
const { title, description = siteDescription, section, math = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/mountain-mark.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={section === 'post' ? 'article' : 'website'} />
    <script is:inline>
      try {
        const preferences = JSON.parse(localStorage.getItem('article-study') || '{}');
        const root = document.documentElement;
        root.dataset.theme = preferences.theme === 'dark' ? 'dark' : 'light';
        root.style.setProperty('--body-font', preferences.font === 'sans' ? 'var(--sans)' : 'var(--serif)');
        const size = Number(preferences.size);
        if (Number.isInteger(size) && size >= 17 && size <= 25) root.style.setProperty('--body-size', `${size}px`);
      } catch {}
    </script>
    {math && <>
      <script is:inline>
        window.MathJax = {
          loader: { paths: { fonts: '/assets/mathjax/fonts' } },
          tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']], tags: 'ams' },
          options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'] },
        };
      </script>
      <script is:inline defer src="/assets/mathjax/tex-chtml.js"></script>
    </>}
  </head>
  <body id="top">
    <a class="skip-link" href="#article-content">Skip to content</a>
    <Header section={section === 'post' ? 'writing' : section} />
    <slot />
    <footer class="site-footer">
      <span>© Veritas · <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a></span>
      <span><a href="https://github.com/VeriTas-arch">GitHub</a></span>
    </footer>
    <script src="../scripts/reader.ts"></script>
    <script>
      // Ask the previous Chirpy worker to update to the retirement worker.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(registrations => {
          for (const registration of registrations) {
            const worker = registration.active || registration.waiting;
            if (worker && new URL(worker.scriptURL).pathname === '/sw.min.js') registration.update().catch(() => {});
          }
        }).catch(() => {});
      }
    </script>
  </body>
</html>
