{
    "name": "veritas-arch",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "prepare:assets": "node scripts/prepare-assets.mjs",
        "dev": "npm run prepare:assets && astro dev --host 127.0.0.1",
        "check": "astro check",
        "build": "npm run prepare:assets && astro build",
        "preview": "astro preview --host 127.0.0.1",
        "test": "node --test tests/*.test.mjs",
        "test:site": "node scripts/check-site.mjs"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "^7.3.2",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "^7.3.8",
        "remark-math": "^6.0.0",
        "mathjax": "3.2.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "cheerio": "^1.2.0",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "micromark-extension-math": {
            "katex": "0.18.2"
        }
    }
}
